  static toResponseDto(entity: MetadataEntity): MetadataResponseDto {
    return {
      id: entity.id,
      name: entity.name,
      description: entity.description ?? null,
      symbol: entity.symbol ?? null,
      image: entity.image,
      bannerImage: entity.bannerImage ?? null,
