    },
    {
      id: "actions",
      header: "Actions",
      cell: ({ row }) => {
        const metadata = row.original;
        return (
          <div className="flex items-center gap-1">
            <Button
              variant="ghost"
              size="icon"
              onClick={() => onView(metadata)}
              title="View JSON"
            >
              <Eye className="h-4 w-4" />
            </Button>
            {metadata.external_url && onViewExternal && (
              <Button
                variant="ghost"
                size="icon"
                onClick={() => onViewExternal(metadata)}
